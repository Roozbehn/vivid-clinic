# ─────────────────────────────────────────────────────────────────────────────
# Google Business Profile API credentials for review import
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# The reviews endpoint lives on the legacy Google My Business API v4
# (https://mybusiness.googleapis.com/v4/.../reviews) — reviews were never
# migrated to the newer split APIs. You need:
#   1. A Google Cloud project with the "Google My Business API" / "My Business
#      Account Management API" enabled, and access granted via the GBP API
#      allow-list form (https://developers.google.com/my-business/content/prereqs).
#   2. An OAuth 2.0 Client ID (type: Web or Desktop).
#   3. A one-time user consent by an account that MANAGES the Vivid Clinic
#      listing, producing a refresh token with scope:
#         https://www.googleapis.com/auth/business.manage
#
# See README-reviews.md → "Getting Google Business Profile API credentials"
# for the step-by-step, including how to mint the refresh token.
# ─────────────────────────────────────────────────────────────────────────────

GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# Optional. If you already know them, set these to skip auto-resolution.
# Account name looks like: accounts/1234567890
# Location name looks like: locations/1234567890  (or accounts/x/locations/y)
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Optional: restrict to a single location by its display title (used only if
# GBP_LOCATION_ID is empty and the account manages multiple locations).
GBP_LOCATION_TITLE=Vivid Clinic

# ─────────────────────────────────────────────────────────────────────────────
# Booking API (Cloudflare Pages Function at /api/booking)
# All optional. With no email provider set, the function still validates and
# accepts leads (returns notified:false); the frontend WhatsApp fallback is then
# the delivery channel. Configure these as Cloudflare Pages environment variables
# (Production + Preview), NOT committed here.
# ─────────────────────────────────────────────────────────────────────────────

# Email notification via Resend (https://resend.com). If both are set, the
# function emails the clinic when a lead is submitted.
# CLINIC_NOTIFY_EMAIL accepts multiple recipients, comma-separated.
RESEND_API_KEY=
CLINIC_NOTIFY_EMAIL=info@vividclinic.net,admin@vividclinic.net
# From address for the notification email (must be a Resend-verified domain).
BOOKING_FROM_EMAIL=Vivid Clinic Booking <booking@vivid.clinic>

# Optional extra allowed CORS origins (comma-separated), in addition to
# https://vivid.clinic and localhost dev. e.g. a staging domain.
BOOKING_ALLOWED_ORIGIN=

# NOTE: Google Sheets / external CRM storage are intentionally NOT wired up.
# Add them only with explicit approval (see README-booking.md → "Notifications").
